{
  "name": "mmcp",
  "packageManager": "yarn@4.18.0",
  "private": true,
  "workspaces": [
    "servers/*",
    "plugins/opencode"
  ],
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "build": "yarn workspaces foreach -A -t run build",
    "test": "yarn build && yarn workspaces foreach -A run test",
    "check-version": "yarn workspaces foreach --no-private --since=\"${BASE_REF:-master}\" run check-version",
    "publish": "yarn workspaces foreach --no-private --topological --since=\"${BASE_REF:-master}\" run publish",
    "publish-all": "yarn workspaces foreach --no-private --topological -A run publish"
  }
}
